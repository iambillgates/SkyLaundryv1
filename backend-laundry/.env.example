# Salin file ini ke .env (jangan commit .env!) lalu isi nilainya.
# cp .env.example .env

# Koneksi database MySQL/MariaDB (Prisma)
# Contoh: mysql://user:password@localhost:3306/laundry_db
DATABASE_URL="mysql://user:password@localhost:3306/laundry_db"

# Secret untuk menandatangani token JWT — WAJIB diisi, string acak yang panjang.
# Buat satu dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN pakai nilai lama yang pernah ter-commit di repo.
JWT_SECRET="isi-dengan-string-acak-minimal-32-karakter"

# Port backend (default 4000)
PORT=4000

# URL frontend yang diizinkan CORS (tanpa slash di akhir)
FRONTEND_URL="http://localhost:3000"
